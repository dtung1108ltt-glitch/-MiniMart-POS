# Phương án A (Khuyến nghị trên Vercel): Để trống VITE_API_BASE_URL để gọi đường dẫn tương đối (/api/...)
# đi qua cấu hình rewrites trong frontend/vercel.json (không lo lỗi CORS, ẩn địa chỉ backend).
VITE_API_BASE_URL=

# Phương án B: Nếu muốn gọi trực tiếp tới URL của Backend trên Render (nhớ cấu hình ALLOWED_ORIGINS ở backend):
# VITE_API_BASE_URL=https://TEN-BACKEND.onrender.com
