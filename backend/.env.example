# Cấu hình môi trường cho Backend Spring Boot (sao chép thành .env khi chạy)
SPRING_PROFILES_ACTIVE=local
PORT=8080
TZ=Asia/Ho_Chi_Minh

# Khi chạy với PostgreSQL (SPRING_PROFILES_ACTIVE=prod):
# Cách 1: Chuỗi DATABASE_URL dạng Render/Railway (tự động chuyển đổi sang JDBC)
# DATABASE_URL=postgres://minimart:minimart@localhost:5432/minimart

# Cách 2: Khai báo tường minh JDBC URL
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/minimart
# SPRING_DATASOURCE_USERNAME=minimart
# SPRING_DATASOURCE_PASSWORD=minimart

# Danh sách Origin được phép gọi CORS (phân tách bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://minimart-pos.vercel.app

# Tỷ giá quy đổi USD -> VND cho sản phẩm tham khảo từ API ngoài (dummyjson.com)
APP_USD_VND_RATE=25000

# Bật chế độ chỉ đọc trên bản demo công khai (chặn xóa sản phẩm / hủy hóa đơn)
DEMO_READONLY=false
